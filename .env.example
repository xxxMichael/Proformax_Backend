# ─── Environment ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:contrasena@localhost:5432/Proformax?schema=public"

# ─── JWT Security ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Azure AI Document Intelligence (Form Recognizer) ─────────
AZURE_FORM_RECOGNIZER_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_API_KEY=your_azure_api_key_here

# ─── Azure Blob Storage (optional - for invoice storage) ──────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_STORAGE_CONTAINER_NAME=proformax-invoices

# ─── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://proformax.arteParquet.com

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs

