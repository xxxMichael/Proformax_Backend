prisma/*.db
prisma/*.db-journal
prisma/dev.db
prisma/migrations/**/steps.json

# Testing / coverage
coverage/
.nyc_output/

# Cache / temp
.cache/
tmp/
temp/
*.tmp
*.temp

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Runtime / process files
*.pid
*.seed

# Optional lockfile backups
package-lock.json.*
yarn.lock.*
pnpm-lock.yaml.*
